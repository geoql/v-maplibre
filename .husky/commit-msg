NAME=$(git config user.name)
EMAIL=$(git config user.email)

if [ -z "$NAME" ]; then
    echo "empty git config user.name"
    exit 1
fi

if [ -z "$EMAIL" ]; then
    echo "empty git config user.email"
    exit 1
fi

# Every commit must carry the author's Signed-off-by trailer. `replace` (not
# the previous `doNothing`) guarantees it: an agent or tool that writes a
# wrong trailer into the message cannot override the real signature — the
# hook always rewrites the trailer to the configured git identity. This is
# what makes the signature a hard invariant instead of a convention.
git interpret-trailers --if-exists replace --trailer \
    "Signed-off-by: $NAME <$EMAIL>" \
    --in-place "$1"

pnpm exec commitlint --edit $1
