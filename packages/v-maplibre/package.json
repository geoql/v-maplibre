{
  "name": "@geoql/v-maplibre",
  "version": "2.0.1",
  "private": false,
  "description": "Vue 3 components for MapLibre GL - reactive map components with full TypeScript support",
  "keywords": [
    "components",
    "deck.gl",
    "deckgl",
    "geospatial",
    "gis",
    "map",
    "maplibre",
    "maplibre-gl",
    "mapping",
    "nuxt",
    "visualization",
    "vue",
    "vue3",
    "webgl"
  ],
  "homepage": "https://github.com/geoql/v-maplibre#readme",
  "bugs": {
