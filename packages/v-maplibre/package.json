  },
  "license": "MIT",
  "author": {
    "name": "Vinayak Kulkarni",
    "email": "inbox.vinayak@gmail.com",
    "url": "https://vinayakkulkarni.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/geoql/v-maplibre.git",
    "directory": "packages/v-maplibre"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./deck.gl": {
      "types": "./dist/deckgl.d.ts",
      "import": "./dist/deckgl.js"
    },
    "./geotiff": {
      "types": "./dist/geotiff.d.ts",
      "import": "./dist/geotiff.js"
    },
    "./wind": {
      "types": "./dist/wind.d.ts",
      "import": "./dist/wind.js"
    },
    "./starfield": {
      "types": "./dist/starfield.d.ts",
      "import": "./dist/starfield.js"
    },
    "./lidar": {
      "types": "./dist/lidar.d.ts",
      "import": "./dist/lidar.js"
    },
    "./splat": {
      "types": "./dist/splat.d.ts",
      "import": "./dist/splat.js"
    },
    "./3d-tiles": {
      "types": "./dist/3d-tiles.d.ts",
      "import": "./dist/3d-tiles.js"
    },
    "./style.css": "./dist/v-maplibre.css",
    "./v-maplibre.css": "./dist/v-maplibre.css",
    "./dist/style.css": "./dist/v-maplibre.css",
    "./dist/v-maplibre.css": "./dist/v-maplibre.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp pack --watch",
    "build": "vp pack",
    "test": "vp test",
    "test:ui": "vp test --ui",
    "test:coverage": "vp test --coverage",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "prepublishOnly": "pnpm run lint && pnpm run format:check && pnpm run test:coverage && pnpm run build"
  },
