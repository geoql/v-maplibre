{
  "name": "v-maplibre-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Vinayak Kulkarni",
    "email": "inbox.vinayak@gmail.com",
    "url": "https://vinayakkulkarni.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/geoql/v-maplibre.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @geoql/v-maplibre run build && pnpm --filter @geoql/mapcn-vue run build && pnpm --filter @geoql/v-maplibre-docs run build && pnpm --filter @geoql/mapcn-vue-app run build",
    "build:docs": "pnpm --filter @geoql/v-maplibre-docs run build",
    "build:mapcn": "pnpm --filter @geoql/mapcn-vue-app run build",
    "dev:docs": "pnpm --filter @geoql/v-maplibre-docs run dev",
    "dev:mapcn": "pnpm --filter @geoql/mapcn-vue-app run dev",
    "dev:lib": "pnpm --filter @geoql/v-maplibre run dev",
    "lint": "pnpm -r run lint",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "typecheck": "pnpm --filter @geoql/v-maplibre run build && pnpm -r run typecheck",
    "test": "pnpm --filter @geoql/v-maplibre run test && pnpm run test:apps",
    "test:apps": "pnpm --filter @geoql/mapcn-vue-app --filter @geoql/v-maplibre-docs --filter @geoql/mapcn-vue run test",
    "test:coverage": "pnpm --filter @geoql/v-maplibre run test:coverage",
    "prepare": "husky || true",
    "clean": "rm -rf node_modules packages/*/node_modules apps/*/node_modules packages/*/dist apps/*/.nuxt apps/*/.output && rm -rf pnpm-lock.yaml",
    "update:deps": "pnpm dlx taze -I -r"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^17.6.0",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:",
    "zod": "^4.6.7",
    "zod-to-json-schema": "^3.25.2"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.x"
    }
  }
}
